# ============================================================
# PolyGlass 大模型 API 密钥配置模板
# 本地开发: 复制为 .env.local 并填入密钥（已被 .gitignore 忽略）
# 线上部署: vercel env add <变量名> production
# 只需配置你要启用的模型，未配置的模型接口会返回"未配置"错误
# ============================================================

# --- 国内模型 ---
# DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 通义千问（阿里云百炼/DashScope） https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# Kimi（月之暗面） https://platform.moonshot.cn
MOONSHOT_API_KEY=

# 智谱 GLM  https://open.bigmodel.cn
ZHIPU_API_KEY=

# 豆包（火山方舟） https://console.volcengine.com/ark
ARK_API_KEY=

# MiniMax  https://platform.minimaxi.com
MINIMAX_API_KEY=

# 腾讯混元  https://console.cloud.tencent.com/hunyuan
HUNYUAN_API_KEY=

# --- 海外模型 ---
# OpenAI  https://platform.openai.com
OPENAI_API_KEY=

# Anthropic Claude  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini  https://aistudio.google.com
GEMINI_API_KEY=

# --- 自部署开源模型（可选，填 OpenAI 兼容服务根地址，如 http://your-host:8000）---
LONGCHAT_BASE_URL=
LONGCHAT_API_KEY=
MIMO_BASE_URL=
MIMO_API_KEY=

# --- 可选：走 New API 网关（部署见 deploy/new-api/README.md）---
# 任一模型设置 *_BASE_URL 指向网关（如 https://gw.vier.cc）即改走网关，
# 对应的 *_API_KEY 改填 New API 令牌；不设则继续直连官方。
# DEEPSEEK_BASE_URL=
# DASHSCOPE_BASE_URL=
# MOONSHOT_BASE_URL=
# ZHIPU_BASE_URL=
# ARK_BASE_URL=
# MINIMAX_BASE_URL=
# HUNYUAN_BASE_URL=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# --- 服务端行为配置（可选，均有默认值）---
# CORS 白名单，逗号分隔（默认 localhost:5173/3000 + https://ai.vier.cc）
ALLOWED_ORIGINS=

# 总结/相关问题使用的模型 id（默认 deepseek）
SUMMARIZER_MODEL=

# 限流：窗口毫秒数 / 窗口内单 IP 最大请求数（默认 60000 / 20）
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
